{
    "api": {
        "nvd": {
            "base_url": "https://services.nvd.nist.gov/rest/json/cves/2.0/",
            "api_key_env": "NVD_API_KEY",
            "timeout": 30,
            "retry_limit": 3,
            "retry_delay": 5,
            "results_per_page": 2000,
            "rate_limit": {
                "base_delay": 0.5,
                "max_delay": 60.0,
                "backoff_multiplier": 2.5,
                "max_retries": 8
            }
        },
        "d3fend": {
            "base_url": "https://d3fend.mitre.org/api/offensive-technique/attack/",
            "timeout": 30,
            "enabled": true
        }
    },
    "database": {
        "download_timeout": 120,
        "capec": {
            "url": "https://capec.mitre.org/data/csv/1000.csv.zip",
            "file": "docs/data/capec_db.json"
        },
        "cwe": {
            "url": "https://cwe.mitre.org/data/xml/cwec_latest.xml.zip",
            "file": "docs/data/cwe_db.json"
        },
        "techniques": {
            "file": "docs/data/techniques_db.json"
        },
        "defend": {
            "file": "docs/data/defend_db.jsonl"
        },
        "kev": {
            "url": "https://raw.githubusercontent.com/cisagov/kev-data/develop/known_exploited_vulnerabilities.json",
            "file": "docs/data/kev_db.json"
        },
        "vulnrichment": {
            "repo": "cisagov/vulnrichment",
            "file": "docs/data/vulnrichment_db.json",
            "state_file": "docs/data/vulnrichment_state.json"
        },
        "epss": {
            "url": "https://epss.empiricalsecurity.com/epss_scores-current.csv.gz",
            "file": "docs/data/epss_curated.json"
        },
        "ctid": {
            "tree_url": "https://api.github.com/repos/center-for-threat-informed-defense/mappings-explorer/git/trees/main?recursive=1",
            "raw_base": "https://raw.githubusercontent.com/center-for-threat-informed-defense/mappings-explorer/main/",
            "file": "docs/data/ctid_db.json"
        },
        "groups": {
            "url": "https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/enterprise-attack/enterprise-attack.json",
            "file": "docs/data/groups_db.json"
        }
    },
    "processing": {
        "max_threads": 10,
        "batch_size": 1000,
        "enable_concurrent_processing": true,
        "cache_size": 1000,
        "cache_ttl": 3600,
        "use_async_processing": false,
        "max_connections": 100,
        "connection_pool_size": 20
    },
    "database_optimization": {
        "use_sqlite": false,
        "cache_size": 1000,
        "enable_streaming": true,
        "batch_insert_size": 500,
        "enable_indexing": true
    },
    "files": {
        "cve_output": "results/new_cves.jsonl",
        "last_update": "lastUpdate.txt",
        "changes": "docs/data/changes.json.gz",
        "database_dir": "docs/database",
        "progress_file": "cve_progress.json"
    },
    "progress_tracking": {
        "save_interval": 5000,
        "log_interval": 10000
    },
    "logging": {
        "level": "INFO",
        "format": "%(asctime)s - %(levelname)s - %(message)s",
        "file": "logs/tip.log",
        "json_file": "logs/tip_errors.json",
        "max_file_size": 10485760,
        "backup_count": 5
    }
}
